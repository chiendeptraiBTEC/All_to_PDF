ATP_ENVIRONMENT=development
ATP_LOG_LEVEL=INFO
ATP_WEB_DIRECTORY=frontend
ATP_LOCAL_STORAGE_DIRECTORY=var/storage
ATP_WORKING_DIRECTORY=var/work
ATP_MAX_UPLOAD_BYTES=52428800
ATP_EMBEDDED_WORKER_ENABLED=false
ATP_ENGINE_TIMEOUT_SECONDS=1800
ATP_TRANSLATION_QPS=4
ATP_TRANSLATION_POOL_MAX_WORKERS=4

# Azure AI Translator (default production provider)
ATP_AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
ATP_AZURE_TRANSLATOR_API_KEY=
ATP_AZURE_TRANSLATOR_REGION=

# Optional OpenAI-compatible LLM provider; M1 profile ID is "default".
ATP_LLM_BASE_URL=
ATP_LLM_API_KEY=
ATP_LLM_MODEL=
ATP_LLM_TIMEOUT_SECONDS=60
