ATP_ENVIRONMENT=development
ATP_LOG_LEVEL=INFO
ATP_WEB_DIRECTORY=frontend
ATP_LOCAL_STORAGE_DIRECTORY=var/storage
ATP_WORKING_DIRECTORY=var/work
ATP_MAX_UPLOAD_BYTES=52428800
ATP_EMBEDDED_WORKER_ENABLED=false

# memory for local single-process development; production for Postgres/Redis/S3.
ATP_PERSISTENCE_BACKEND=memory
ATP_DATABASE_URL=
ATP_REDIS_URL=
ATP_S3_ENDPOINT_URL=
ATP_S3_BUCKET=
ATP_S3_REGION=us-east-1
ATP_S3_ACCESS_KEY_ID=
ATP_S3_SECRET_ACCESS_KEY=
ATP_QUALITY_MODE=basic
ATP_MIN_READABLE_SCALE=0.62

# Required before a production worker may load the pinned AGPL engine dependencies.
ATP_THIRD_PARTY_LICENSE_ACKNOWLEDGED=false

ATP_AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
ATP_AZURE_TRANSLATOR_API_KEY=
ATP_AZURE_TRANSLATOR_REGION=
ATP_LLM_BASE_URL=
ATP_LLM_API_KEY=
ATP_LLM_MODEL=
